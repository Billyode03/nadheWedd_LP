---
import { Image } from 'astro:assets';
import DeviceFrame from './DeviceFrame.astro';
import Icon from './Icon.astro';
import { hero } from '../config/site';
import { florals, screenshots } from '../assets';
import { waLink } from '../lib/whatsapp';
---

<section id="beranda" class="paper section overflow-hidden !pt-10 lg:!pt-16" aria-labelledby="hero-title">
  <Image
    src={florals.topRight}
    alt=""
    width={360}
    class="floral -right-16 -top-10 w-[220px] opacity-40 sm:w-[300px] lg:w-[360px]"
    loading="eager"
    aria-hidden="true"
  />
  <Image
    src={florals.bottomLeft}
    alt=""
    width={300}
    class="floral -bottom-24 -left-24 hidden w-[300px] opacity-30 lg:block"
    loading="lazy"
    aria-hidden="true"
  />

  <div class="container-page grid items-center gap-14 lg:grid-cols-[1fr_1.08fr] lg:gap-10">
    <div class="text-center lg:text-left">
      <p class="eyebrow text-gold-deep">{hero.eyebrow}</p>
      <h1
        id="hero-title"
        class="mt-4 text-[2.35rem] leading-[1.1] text-maroon sm:text-[3.2rem] lg:text-[3.6rem] xl:text-[4rem]"
      >
        {hero.title}
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-[0.98rem] leading-relaxed text-warm-gray lg:mx-0 lg:text-[1.05rem]">
        {hero.copy}
      </p>

      <ul class="mt-6 flex flex-wrap justify-center gap-2 text-[0.75rem] text-ink/80 lg:justify-start" aria-label="Layanan NadheWedd">
        <li class="rounded-full border border-gold/40 bg-ivory/70 px-3 py-1.5">Undangan Digital</li>
        <li class="rounded-full border border-gold/40 bg-ivory/70 px-3 py-1.5">Buku Tamu QR</li>
        <li class="rounded-full border border-gold/40 bg-ivory/70 px-3 py-1.5">Web Album</li>
      </ul>

      <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a href={hero.primaryCta.href} class="btn btn-primary">
          {hero.primaryCta.label}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href={waLink()} target="_blank" rel="noopener" class="btn btn-outline">
          <Icon name="whatsapp" class="h-4 w-4" />
          {hero.whatsappCta}
        </a>
      </div>
    </div>

    <div class="relative mx-auto aspect-[5/4] w-full max-w-[36rem] lg:max-w-none">
      <DeviceFrame
        src={screenshots.kameraSapaan}
        alt="Buku Tamu Digital dalam Mode Kamera menyambut tamu dengan namanya"
        device="laptop"
        sizes="(min-width: 1024px) 520px, 80vw"
        eager
        class="absolute right-[2%] top-0 w-[86%]"
      />
      <DeviceFrame
        src={screenshots.qrPribadi}
        alt="QR check-in pribadi tamu di undangan digital"
        device="phone"
        sizes="(min-width: 1024px) 170px, 28vw"
        eager
        class="absolute bottom-0 left-0 w-[27%] rotate-[-3deg]"
      />
      <div
        class="frame-inset absolute bottom-[4%] right-[2%] flex items-center gap-3 rounded-2xl px-3.5 py-2.5 sm:px-5 sm:py-4"
      >
        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-champagne/50 text-gold-deep">
          <Icon name="image" class="h-[1.15rem] w-[1.15rem]" />
        </span>
        <span class="leading-tight">
          <span class="block font-display text-[0.95rem] text-maroon">Web Album</span>
          <span class="mt-0.5 block text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-gold-deep">Foto dari tamu</span>
        </span>
      </div>
    </div>
  </div>
</section>
