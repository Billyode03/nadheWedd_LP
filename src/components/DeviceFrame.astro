---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  /** Omit for a clearly labelled "Screenshot menyusul" placeholder (no fake UI). */
  src?: ImageMetadata;
  alt: string;
  device: 'phone' | 'laptop';
  /** `sizes` attribute for the responsive image. */
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, device, sizes, eager = false, class: className = '' } = Astro.props;
const widths = device === 'phone' ? [200, 280, 390] : [480, 800, 1280];
const defaultSizes = device === 'phone' ? '(min-width: 1024px) 240px, 60vw' : '(min-width: 1024px) 640px, 92vw';
const loading = eager ? 'eager' : 'lazy';
const fetchpriority = eager ? 'high' : undefined;
---

{
  device === 'phone' ? (
    <figure class={className}>
      <div class="rounded-[2rem] bg-ink p-[5px] shadow-[0_30px_50px_-30px_rgb(74_41_37/0.75)] ring-1 ring-gold/30">
        <div class="relative overflow-hidden rounded-[1.65rem] bg-cream">
          {src ? (
            <Picture
              src={src}
              alt={alt}
              widths={widths}
              sizes={sizes ?? defaultSizes}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              loading={loading}
              fetchpriority={fetchpriority}
              decoding="async"
              class="block h-auto w-full"
            />
          ) : (
            <div role="img" aria-label={`${alt} — screenshot menyusul`} class="flex aspect-[390/844] flex-col items-center justify-center gap-3 bg-gradient-to-b from-ivory to-sand p-4 text-center">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-dashed border-gold-deep/50 text-gold-deep">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11A1.5 1.5 0 0 1 4.5 5ZM3 15.5l5-4.5 4 3.5 3-2.5 6 5"/></svg>
              </span>
              <span class="text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-gold-deep">Screenshot menyusul</span>
            </div>
          )}
          <span
            aria-hidden="true"
            class="absolute left-1/2 top-2 h-[14px] w-[30%] -translate-x-1/2 rounded-full bg-ink/90"
          />
        </div>
      </div>
    </figure>
  ) : (
    <figure class={className}>
      <div class="rounded-t-[0.9rem] bg-ink p-[1.6%] pb-[2%] shadow-[0_30px_60px_-34px_rgb(74_41_37/0.8)] ring-1 ring-gold/25">
        <div class="overflow-hidden rounded-[0.35rem] bg-cream">
          {src ? (
            <Picture
              src={src}
              alt={alt}
              widths={widths}
              sizes={sizes ?? defaultSizes}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              loading={loading}
              fetchpriority={fetchpriority}
              decoding="async"
              class="block h-auto w-full"
            />
          ) : (
            <div role="img" aria-label={`${alt} — screenshot menyusul`} class="flex aspect-[1280/800] flex-col items-center justify-center gap-3 bg-gradient-to-b from-ivory to-sand text-center">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-dashed border-gold-deep/50 text-gold-deep">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11A1.5 1.5 0 0 1 4.5 5ZM3 15.5l5-4.5 4 3.5 3-2.5 6 5"/></svg>
              </span>
              <span class="text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-gold-deep">Screenshot menyusul</span>
            </div>
          )}
        </div>
      </div>
      <div
        aria-hidden="true"
        class="relative mx-[-4%] h-[10px] rounded-b-[0.9rem] bg-gradient-to-b from-beige to-[#d9c7aa] shadow-[0_12px_18px_-12px_rgb(74_41_37/0.6)] sm:h-[14px]"
      >
        <span class="absolute left-1/2 top-0 h-[40%] w-[14%] -translate-x-1/2 rounded-b-md bg-[#cdb895]" />
      </div>
    </figure>
  )
}
