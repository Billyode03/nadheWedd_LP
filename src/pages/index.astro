---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProductOverview from '../components/ProductOverview.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import Benefits from '../components/Benefits.astro';
import FirstImplementation from '../components/FirstImplementation.astro';
import Packages from '../components/Packages.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Navbar />
  <main id="konten">
    <Hero />
    <ProductOverview />
    <HowItWorks />
    <ProductShowcase />
    <Benefits />
    <FirstImplementation />
    <Packages />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</Base>
